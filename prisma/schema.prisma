// VANTA — customer accounts, sessions, saved bag/wishlist, addresses, and the
// published site content.
//
// Product ids are plain strings with no foreign key. The catalogue lives in the
// content store, not in its own table: a bag line, a saved item and an order
// all record the id they were created against and resolve it against the live
// catalogue when rendered. That is the same rule the browser-local bag already
// follows, and it is why deleting a product cannot orphan a row here.

generator client {
  provider = "prisma-client"
  // Outside `app/` on purpose — anything under the App Router is scanned for
  // route files, and generated code has no business being looked at twice.
  // Gitignored, so it is absent on a fresh clone. Regenerated by
  // `npm run build` and, before that, by the predeploy gate — which imports it
  // and therefore cannot wait for the build. §38.
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The URL lives in `prisma.config.ts`. Prisma 7 removed it from here.
}

/// A shopper. Distinct from the single admin user, which is still a pair of
/// environment variables and deliberately not a row in this table — the admin
/// is infrastructure, customers are data.
model Customer {
  id String @id @default(cuid())

  /// Stored lowercased and trimmed. The unique index is what makes
  /// "an account already exists" a database guarantee rather than a race.
  email String @unique

  name  String?
  phone String?

  /// scrypt, salted per row. See `lib/auth/password.ts` for the encoding.
  /// Never selected into anything that reaches a client component.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       CustomerSession[]
  passwordResets PasswordResetToken[]
  addresses      Address[]
  bagLines       BagLine[]
  wishlist       WishlistItem[]
  orders         Order[]

  @@index([createdAt])
}

/// A signed-in browser.
///
/// Sessions are rows, not self-contained JWTs, so that "sign out" and "sign out
/// everywhere" actually revoke something. The cookie carries a random opaque
/// token; only its SHA-256 digest is stored, so a leaked database dump cannot
/// be replayed as a login.
model CustomerSession {
  id String @id @default(cuid())

  /// SHA-256 of the cookie value, hex. Unique so a lookup is one index hit.
  tokenHash String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  /// Context for the "where you're signed in" list, and for revoking a device.
  userAgent String?
  ip        String?

  @@index([customerId])
  @@index([expiresAt])
}

/// A "forgot password" link that has been emailed. §44.
///
/// Stored the way customer sessions are: the link carries a random token and
/// only its SHA-256 digest is kept, so a leaked database cannot be turned into
/// working reset links. Single use (`usedAt`), short-lived (`expiresAt`), and a
/// customer has at most one outstanding — asking again deletes the older ones.
model PasswordResetToken {
  id String @id @default(cuid())

  /// SHA-256 of the token in the link, hex.
  tokenHash String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// Set when the link is used. A used token is never accepted again.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Who asked, for the record. Best-effort, like every other `ip` column.
  ip String?

  @@index([customerId])
}

/// A delivery address. Shaped for Indian shipping and for what a courier
/// aggregator asks for at pickup — name, phone, two lines, city, state, pincode.
model Address {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fullName String
  phone    String
  line1    String
  line2    String?
  city     String
  state    String
  /// Six digits. Validated in the action, not by the column, so a bad value
  /// comes back as a form error rather than a 500.
  pincode  String
  country  String  @default("IN")

  /// At most one per customer; enforced by the action, which clears the flag
  /// on the others inside the same transaction.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

/// The signed-in bag. One row per product and size, quantity only — no name,
/// price or image, for the same reason `components/BagProvider.tsx` stores none.
model BagLine {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  /// The size's SKU (§47). Empty for a line saved before sizes were carried,
  /// or for a product with no sizes — empty rather than null so it can be part
  /// of the primary key.
  sku       String @default("")
  qty       Int

  updatedAt DateTime @updatedAt

  @@id([customerId, productId, sku])
}

/// The signed-in wishlist. A set of product ids; `createdAt` is what makes
/// "newest first" survive the trip to another device.
model WishlistItem {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  createdAt DateTime @default(now())

  @@id([customerId, productId])
}

/// The published site content and the unpublished draft — the Postgres half of
/// `lib/contentStore.ts`.
///
/// Two rows, keyed "published" and "draft", each holding the whole document.
/// It is a few kilobytes, it is read as a unit and written as a unit, and
/// shredding it into tables would put the schema in two places at once.
model ContentDocument {
  /// "published" | "draft"
  key     String   @id
  content Json
  savedAt DateTime @default(now()) @updatedAt
}

/// A rate-limit bucket, keyed by whatever the caller is limiting on.
///
/// In Postgres rather than a module-level Map because on a serverless host
/// every request can be a fresh process: the Map resets constantly, and the
/// effective limit becomes "five attempts per instance", which against
/// /admin/login is barely a limit at all.
///
/// The key is scoped by the caller (`admin:ip:1.2.3.4`, `admin:user:bunny`) so
/// that IP and identifier are counted separately — one attacker working from
/// many IPs cannot lock a real administrator out of their own account, and one
/// IP cannot dodge the limit by spreading guesses across many usernames.
model RateLimitBucket {
  key String @id

  /// Failures inside the current window.
  failures Int @default(0)

  /// Start of the window. Failures older than the window are forgotten by
  /// resetting rather than by storing every timestamp — a count and a start
  /// time answer the same question in two columns instead of an array.
  windowStartedAt DateTime @default(now())

  /// Set once the limit trips. Null means "not locked".
  lockedUntil DateTime?

  /// How many times this key has been locked out. Drives exponential backoff:
  /// a second lockout lasts longer than the first.
  lockoutCount Int @default(0)

  updatedAt DateTime @updatedAt

  /// Swept by `pruneRateLimits()`. Indexed so the sweep is a range scan rather
  /// than a full table scan once this table is large.
  @@index([updatedAt])
}

/// A signed-in administrator.
///
/// §17 accepted that the admin's JWT could not be revoked, because there was
/// no database to revoke against. There is now.
///
/// The token still exists and middleware still checks it on the Edge without
/// opening a connection — that check is what stops admin markup flashing before
/// a redirect. It is not authorization. The row is: every admin page and every
/// admin action re-checks it through `lib/adminSession.ts` before doing
/// anything, and a revoked row makes the still-valid token worthless.
model AdminSession {
  id String @id @default(cuid())

  /// Which admin username the session was issued to. Not a foreign key: the
  /// administrator is a pair of environment variables, not a row.
  username String

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  /// Set instead of deleting, so "signed out at 14:02 from this address" stays
  /// answerable after the fact. Deleting would erase the evidence.
  revokedAt  DateTime?

  userAgent String?
  ip        String?

  @@index([username])
  @@index([expiresAt])
}

/// What happened in the admin, who did it, and from where.
///
/// Append-only by convention — nothing in the app updates or deletes a row.
/// Never records a password, a session token, a captcha secret or a request
/// body: an audit log that contains credentials is a second place to steal
/// them from, and the whole point is that it can be read.
model AdminAuditLog {
  id String @id @default(cuid())

  at DateTime @default(now())

  /// Username where known; "anonymous" for a failed sign-in, which is the one
  /// case where the actor is a claim rather than a fact.
  actor String

  /// A stable machine-readable verb — "admin.signin.failed", "content.publish".
  action String

  /// What was acted on, when that makes sense: a product id, a section key.
  target String?

  /// Anything else worth keeping. Small, structured, and never a credential.
  detail Json?

  ip        String?
  userAgent String?

  @@index([at])
  @@index([actor])
  @@index([action])
}

/// Where an order is in its life.
///
/// A small closed set rather than a free string, because every one of these is
/// branched on somewhere — a cancelled order must not ship, a pending-payment
/// order must not be picked. A typo in a string column would be a state nothing
/// handles and nothing rejects.
enum OrderStatus {
  /// ONLINE payment selected, nothing captured yet. The seam where a payment
  /// provider will slot in; nothing downstream should treat these as sold.
  PENDING_PAYMENT
  /// COD placed, or payment captured. The shop owes the customer goods.
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

/// A placed order.
///
/// Everything money-related is an Int of paise, never a float. 0.1 + 0.2 is not
/// 0.3 in binary floating point, and a rounding error in a currency column is
/// the kind of bug that is only found by a customer reading their invoice.
/// Rupees are reconstructed for display, once, at the edge.
model Order {
  id String @id @default(cuid())

  /// The number a human quotes on the phone — VNT-2026-00042.
  ///
  /// Separate from the cuid because a cuid is unreadable aloud and leaks
  /// nothing useful, while this is short, sequential within a year, and
  /// obviously an order. The cuid stays the primary key: order numbers are
  /// generated under contention and a collision must fail a unique check, not
  /// corrupt a relation.
  orderNumber String @unique

  /// Null for a guest. Not a required relation: most first orders are placed
  /// before anyone makes an account, and forcing registration at checkout is
  /// the single most reliable way to lose the sale.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Always captured, account or not — it is how the order is confirmed and
  /// how a guest is found again.
  email String

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod

  /// The delivery address, copied rather than referenced.
  ///
  /// An Address row can be edited or deleted after the fact; an order must
  /// still say where it actually went. Pointing at the row would rewrite
  /// history the moment someone corrected a typo in their address book.
  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String
  shipCountry String  @default("IN")

  /// All in paise. `subtotal` is the sum of the lines; the rest are zero until
  /// shipping and discounts exist, and are present now so adding them later is
  /// a value change rather than a migration on a table with orders in it.
  subtotal Int
  shipping Int @default(0)
  discount Int @default(0)
  total    Int

  /// Free-text note from the customer at checkout.
  note String?

  /// --- Payment (Razorpay) -------------------------------------------------
  /// The provider's order id, created before handing off to their checkout.
  /// Nullable: a COD order never has one.
  razorpayOrderId   String?   @unique
  /// Set only by the webhook, never by the browser callback. See §27.
  razorpayPaymentId String?
  paidAt            DateTime?

  /// --- Cancellation and refund (§48) --------------------------------------
  /// When and why the order stopped. `payment-timeout` is the sweep in
  /// `lib/payments/expiry.ts`; stock is returned in the same transaction.
  cancelledAt  DateTime?
  cancelReason String?
  /// Refund started from /admin/orders. `refundStatus` is Razorpay's own word
  /// — pending, processed or failed — updated by the refund webhooks.
  razorpayRefundId String?   @unique
  refundStatus     String?
  refundedAt       DateTime?

  /// --- Delivery (Shiprocket) ----------------------------------------------
  /// Their internal ids, kept so a re-push can update rather than duplicate.
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  awb                  String?
  courierName          String?
  trackingUrl          String?
  /// Where the courier says it is, in their words. Displayed, never branched on.
  courierStatus        String?
  /// Null until a push succeeds. Non-null with no awb means it was accepted
  /// but not yet assigned a courier.
  pushedToCourierAt    DateTime?
  /// Why the last push failed, for the admin to act on. Cleared on success.
  courierError         String?

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([email])
  @@index([placedAt])
  @@index([status])
}

/// One line of an order, snapshotted.
///
/// This is the deliberate opposite of `BagLine`, and the difference is the
/// whole point of the two models existing separately.
///
/// A bag stores a product id and nothing else, so it always resolves against
/// the live catalogue: change a price in /admin and every bag holding that
/// product shows the new price, which is correct — nobody has agreed to
/// anything yet.
///
/// An order is a record of an agreement. It must say what was actually bought,
/// at the price actually charged, under the name the customer actually saw. If
/// it resolved against the catalogue the way a bag does, renaming a product
/// would rewrite old invoices, deleting one would empty a past order, and a
/// price rise would retroactively change what someone paid. So the title, the
/// price and the image are copied at purchase time and never touched again.
///
/// `productId` is kept alongside the snapshot, without a foreign key, purely so
/// "buy it again" can find the product if it still exists. Nothing about
/// rendering the order depends on it resolving.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// The catalogue id at the time of purchase. No relation on purpose — a
  /// deleted product must not cascade away a line of somebody's order.
  productId String

  /// Snapshot. Never re-read from the catalogue.
  title     String
  imageSrc  String
  imageAlt  String
  /// The size bought, and its SKU, as they were at purchase (§47). Null on
  /// orders placed before sizes were carried — those never recorded one.
  size      String?
  sku       String?
  /// Unit price in paise, as charged.
  unitPrice Int
  quantity  Int
  /// unitPrice * quantity, stored rather than derived, so a line total can be
  /// read back exactly as it was written even if the rule ever changes.
  lineTotal Int

  @@index([orderId])
  @@index([productId])
}

/// How many of a size are in stock (§47). Keyed by the variant's SKU, which is
/// stored on the product in the content document (§41).
///
/// A table, not a field on the product, for the reason §41 gives: the content
/// document is read and written whole on every publish, so a count inside it
/// could not be decremented atomically and a publish would overwrite every
/// sale made since the editor loaded the page.
///
/// **No row means not tracked**, and a size that is not tracked is always
/// available — so a shop can go live before anyone has counted anything, and
/// start tracking one product at a time. A row at 0 is sold out.
model StockLevel {
  sku       String   @id
  quantity  Int
  updatedAt DateTime @updatedAt
}

/// Webhook deliveries already handled, so replaying one changes nothing.
///
/// Providers retry aggressively and at-least-once delivery is the norm — a
/// captured payment can arrive three times. Without this, the third delivery
/// would re-run whatever the first did.
///
/// Keyed on the provider's own event id where they send one, and on a digest
/// of the raw body where they do not. The unique index is the actual guard:
/// two deliveries racing each other both try to insert, and exactly one wins.
model WebhookEvent {
  id String @id @default(cuid())

  /// "razorpay" | "shiprocket"
  provider  String
  /// Provider event id, or a sha256 of the body when they send none.
  eventKey  String
  /// The event name, for reading the log later. Never branched on for identity.
  eventType String?

  receivedAt DateTime @default(now())

  /// When this event reached a **terminal** outcome — not when it arrived.
  ///
  /// The distinction is the whole point of the column. The row is inserted as
  /// a *claim* the moment an event is accepted, because an insert against the
  /// unique index is the only thing that beats a concurrent redelivery. But a
  /// claim is not completion: a payment for an order that has not been written
  /// yet, or one whose amount did not match, has been *seen* and not *acted
  /// on*.
  ///
  /// Null therefore means "arrived, still owed work". Those rows are a
  /// reconciliation queue — see `/admin/orders`. §29.
  processedAt DateTime?

  /// How many deliveries of this event have been processed. Only ever climbs
  /// above 1 when an earlier attempt failed to reach a terminal outcome, which
  /// makes it the signal for "this one keeps coming back".
  attempts Int @default(0)

  @@unique([provider, eventKey])
  @@index([receivedAt])
  /// Drives the reconciliation queue: unprocessed first, oldest first.
  @@index([processedAt, receivedAt])
}

/// Work that must happen but must not block the customer.
///
/// Pushing an order to a courier is the case this exists for: Shiprocket being
/// slow or down must never stop an order being placed. The push is enqueued
/// inside the order transaction and drained separately, so the checkout path
/// depends on nothing external.
model OutboxJob {
  id String @id @default(cuid())

  /// "shiprocket.push"
  kind    String
  /// The order this is about. Not a relation: a job outliving its order should
  /// fail on its own terms rather than vanish.
  orderId String

  attempts    Int       @default(0)
  /// Exponential backoff — the job is invisible to the drainer until then.
  runAfter    DateTime  @default(now())
  lastError   String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([completedAt, runAfter])
  @@index([orderId])
}

/// A cached bearer token for a third-party API.
///
/// Exists because Shiprocket's auth tokens last 240 hours (10 days) and their
/// login endpoint is rate-limited and slow. Logging in per request would be
/// both wasteful and, in practice, a way to get locked out.
///
/// In the database rather than in a module-level variable because this app is
/// deployed serverless: every cold start is a fresh process, and a process-local
/// cache would mean a login on each one. Keyed by provider, one row per
/// integration.
model IntegrationToken {
  /// "shiprocket". The primary key — there is exactly one token per provider.
  provider String @id

  /// The bearer token, **encrypted** with AES-256-GCM — never plaintext.
  ///
  /// Named for what it holds so the invariant survives contact with the next
  /// reader: a column called `token` containing ciphertext invites somebody to
  /// log it, compare it, or "fix" it. Format and reasoning are in
  /// `lib/crypto/secretBox.ts`; the short version is that this is a bearer
  /// credential for the whole Shiprocket account, it has to be replayed so a
  /// digest is no use, and every other secret this codebase stores is hashed.
  ///
  /// Nothing is written here at all when SECRET_ENCRYPTION_KEY is unset. The
  /// cache is simply skipped rather than downgraded to plaintext.
  tokenCiphertext String
  /// When it stops being usable. Refreshed before this, never after.
  expiresAt       DateTime

  updatedAt DateTime @updatedAt
}
